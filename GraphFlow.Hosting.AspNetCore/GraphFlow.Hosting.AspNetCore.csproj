<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>bcn.GraphFlow.Hosting.AspNetCore</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>Brandon Nesiba</Authors>
    <Description>ASP.NET Core endpoints and optional embedded Explorer UI for registered GraphFlow graphs.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="bcn.GraphFlow" Version="1.1.0" />
    <EmbeddedResource Include="UI/*" LogicalName="GraphFlow.Hosting.UI.%(Filename)%(Extension)" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
